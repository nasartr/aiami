
<odoo>
  <record id="view_partner_form_dealer" model="ir.ui.view">
    <field name="name">res.partner.form.dealer</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/notebook" position="inside">
        <page string="Dealer">
          <group>
            <field name="is_dealer"/>
            <field name="dealer_code"/>
            <field name="branch_id"/>
            <field name="sales_executive_id"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>

  <record id="view_partner_tree_dealer_only" model="ir.ui.view">
    <field name="name">res.partner.tree.dealer.only</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <list string="Dealers" create="true">
        <field name="name"/>
        <field name="dealer_code"/>
        <field name="is_dealer"/>
        <field name="branch_id"/>
        <field name="sales_executive_id"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="city"/>
        <field name="country_id"/>
      </list>
    </field>
  </record>
</odoo>
