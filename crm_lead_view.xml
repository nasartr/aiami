<odoo>
    <record id="crm_lead_form_inherit_product" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.product</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <field name="product_id" string="Product" nolabel="0"/>
            </xpath>
        </field>
    </record>
</odoo>