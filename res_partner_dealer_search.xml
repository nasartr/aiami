
<odoo>
  <record id="view_partner_search_dealer" model="ir.ui.view">
    <field name="name">res.partner.search.dealer</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_res_partner_filter"/>
    <field name="arch" type="xml">
      <xpath expr="//filter[@name='customer']" position="after">
        <filter string="Dealers" name="is_dealer" domain="[('is_dealer','=',True)]"/>
      </xpath>
    </field>
  </record>
</odoo>
