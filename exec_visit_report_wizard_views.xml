
<odoo>
  <record id="view_exec_visit_report_wizard" model="ir.ui.view">
    <field name="name">exec.visit.report.wizard.form</field>
    <field name="model">exec.visit.report.wizard</field>
    <field name="arch" type="xml">
      <form string="Executive-wise Field Visit Report">
        <group>
          <field name="date_from"/>
          <field name="date_to"/>
          <field name="branch_id"/>
          <field name="employee_ids" widget="many2many_tags"/>
        </group>
        <footer>
          <button name="action_print" type="object" class="btn-primary" string="Print PDF"/>
          <button special="cancel" string="Close"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
